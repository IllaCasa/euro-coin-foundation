# Define these values according to where Terraform runs:
# - Local execution: copy this file to .env and fill in the values.
#   Load from the repository root: set -a; source .env; set +a
#   Terraform does not load .env automatically.
# - Remote execution in HCP Terraform: define the values in the workspace.
#   SUPABASE_ACCESS_TOKEN: Environment variable, marked as Sensitive.
#   organization_id: Terraform variable, without the TF_VAR_ prefix.
#   database_password: Terraform variable, without TF_VAR_, marked as Sensitive.

# Supabase personal access token.
SUPABASE_ACCESS_TOKEN=''

# Supabase organization slug.
TF_VAR_organization_id=''

# Project database password.
TF_VAR_database_password=''
